              "kind": "person"
            }
          },
          "fragments": []
        },
        "status": 200,
        "method": "GET"
      },
      {
        "path": "/fragment/a",
        "body": "<p xml:id=\"p1\">山<app xml:id=\"a1\"><lem wit=\"#w1\">川</lem><rdg wit=\"#g\">河</rdg></app><gap reason=\"lost\" extent=\"2\"/></p>",
        "status": 200,
        "method": "GET"
      }
    ],
    "expected": [
      {
        "scope": "A",
        "fragment": "p1",
        "readings": [
          {
            "kind": "lem",
            "text": "川",
            "witnesses": [
              "A/w1"
            ]
          },
          {
            "kind": "rdg",
            "text": "河",
            "witnesses": [
              "A/w1",
              "B/w1"
            ]
          }
        ]
      }
    ],
    "forbidden": []
